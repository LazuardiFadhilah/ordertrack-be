# Server project environment template.
# Keep values blank. Set values in local or Vercel environment settings.
# For cookie behavior by environment, see docs/ENV.md.

# Database
MONGODB_URI=

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=
AUTH_COOKIE_NAME=
AUTH_COOKIE_SECURE=

# API access
CORS_ORIGIN=
PORT=

# Storage provider-neutral signed upload contract. No credentials are committed.
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Cron endpoint authentication
CRON_SECRET=
